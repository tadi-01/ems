# Port the Express server listens on. Render sets this itself when deployed.
PORT=5000

# MongoDB Atlas connection string. Replace username, password and cluster with your own.
MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/employee_management

# Long random text used to sign login tokens. Keep it secret and never commit it.
JWT_SECRET=replace_with_a_long_random_text

# Address of the deployed React app, with no slash at the end. Only this address
# (and http://localhost:5173 for development) may call the API from a browser.
CLIENT_URL=https://your-app.vercel.app

# Used only by "npm run create-admin" to make the first Admin account.
# Delete ADMIN_PASSWORD from the .env file after you have run it.
ADMIN_NAME=Your Name
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=choose_a_strong_password

# Calendar dates use this IANA company time zone, not the host clock.
COMPANY_TIME_ZONE=Africa/Harare
# Existing leave policy defaults are preserved. Use working to exclude weekends.
ANNUAL_LEAVE_DAYS=21
LEAVE_DAY_MODE=calendar
# Optional comma-separated YYYY-MM-DD holidays, excluded only in working mode.
PUBLIC_HOLIDAYS=
# Optional payslip heading and currency code, copied when the payslip is created.
COMPANY_NAME=
PAYROLL_CURRENCY=
